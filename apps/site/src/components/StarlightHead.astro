---
// Starlight renders only the frontmatter `head` entries in this component, so
// this override keeps that behaviour and appends the docs breadcrumb trail.
import Umami from "./Umami.astro";

const { head, entry } = Astro.locals.starlightRoute;
const base = Astro.site ?? new URL("http://localhost:3300");
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "mish", item: new URL("/", base).href },
    {
      "@type": "ListItem",
      position: 2,
      name: entry.data.title,
      item: new URL(Astro.url.pathname, base).href,
    },
  ],
};
const jsonLd = JSON.stringify(breadcrumbs).replace(/</g, "\\u003c");
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<script type="application/ld+json" set:html={jsonLd} />
<Umami />
