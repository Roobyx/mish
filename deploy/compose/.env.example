# mish compose/Portainer environment variables.
# Copy to .env and adjust.

# Image tag to build/run.
MISH_TAG=dev

# Host address/port for the app (web client + API).
# The default publishes only on loopback. For LAN access set
# MISH_PUBLISH_ADDR=0.0.0.0, MISH_BIND=0.0.0.0:8080 and a strong
# MISH_AUTH_TOKEN. The server refuses to start unauthenticated on a
# non-loopback bind.
MISH_PUBLISH_ADDR=127.0.0.1
MISH_PORT=8080
MISH_BIND=0.0.0.0:8080

# Bearer token required by the API. Leave empty only for a loopback bind.
# Generate one with: openssl rand -hex 32
MISH_AUTH_TOKEN=

# Host header values accepted by the API (DNS-rebinding guard). Add the
# hostname or IP clients use when exposing the service on a LAN.
MISH_ALLOWED_HOSTS=localhost,127.0.0.1

# Set true only when a trusted reverse proxy sets X-Forwarded-Host/For.
MISH_TRUST_PROXY=false

# Host port for the docs/landing site. Canonical default is 3000; 3300 is used
# here to avoid colliding with an existing service on shared hosts.
MISH_SITE_PORT=3300

# Host path to expose read-only at /host inside the container.
# Use / for the whole host, or a narrower path such as /mnt/data.
# Each filesystem mounted into the container becomes one card on the Drives
# dashboard; to show a second drive, add its bind mount to the service's
# volumes (e.g. /mnt/backup:/host/mnt/backup:ro).
HOST_MOUNT=/

# Roots the core may scan. Keep this as narrow as possible; the API rejects
# paths outside it. Must be inside the /host mount.
MISH_ROOTS=/host

# Docker is read-only and goes through the GET-only socket proxy.
MISH_DOCKER=true
DOCKER_HOST=tcp://docker-socket-proxy:2375
