# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# mish/server — Rust core + Bun/Hono API server + Svelte web client
# ---------------------------------------------------------------------------

# ---- Stage 1: Rust core (static musl binary) ----
FROM rust:1.99-alpine AS core-build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
# Build the CLI/daemon, then gate the image on the core test suite.
RUN cargo build --release --locked --bin mish \
 && cargo test --workspace --release --locked

# ---- Stage 2: TypeScript build (server + web) ----
FROM oven/bun:1.4.2-alpine AS js-build
ARG MISH_WEB_BASE=/
ENV MISH_WEB_BASE=$MISH_WEB_BASE
WORKDIR /src
COPY package.json bun.lock tsconfig.base.json biome.json ./
COPY packages ./packages
COPY apps/server ./apps/server
COPY apps/web ./apps/web
RUN bun install --frozen-lockfile
# Gate on the TS test suites before producing artefacts.
RUN bun run --filter '@mish/api-types' test \
 && bun run --filter '@mish/server' test \
 && bun run --filter '@mish/web' test
RUN bun run --filter '@mish/server' build \
 && bun run --filter '@mish/web' build

# ---- Stage 3: runtime ----
FROM oven/bun:1.4.2-alpine AS runtime
RUN addgroup -S mish && adduser -S -G mish -h /app mish
WORKDIR /app
COPY --from=core-build /src/target/release/mish /usr/local/bin/mish
COPY --from=js-build /src/apps/server/dist ./server
COPY --from=js-build /src/apps/server/package.json ./package.json
COPY --from=js-build /src/apps/web/dist ./web
# Docker's cap_add only fills the bounding set, so a non-root user gets no
# effective capabilities. Copy the executables into this layer and set the cap
# on the copies; the `mish` user then gets it on exec without running as root.
RUN apk add --no-cache --virtual .cap-tools libcap-setcap \
 && cp /usr/local/bin/mish /usr/local/bin/mish-capped \
 && cp /usr/local/bin/bun /usr/local/bin/bun-capped \
 && setcap cap_dac_read_search+ep /usr/local/bin/mish-capped /usr/local/bin/bun-capped \
 && apk del .cap-tools
RUN mkdir -p /data /run/mish && chown -R mish:mish /data /run/mish /app

ENV MISH_DATA_DIR=/data \
    MISH_BIND=0.0.0.0:9543 \
    MISH_WEB_DIR=/app/web \
    MISH_CORE_SOCKET=/run/mish/mish.sock \
    MISH_CORE_BIN=/usr/local/bin/mish-capped

EXPOSE 9543
VOLUME ["/data"]

# Runs as the unprivileged `mish` user. Compose grants only
# CAP_DAC_READ_SEARCH so the core can read the whole (read-only) host mount.
USER mish

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
  CMD wget -qO- http://127.0.0.1:9543/api/v1/health || exit 1

CMD ["/usr/local/bin/bun-capped", "run", "/app/server/index.js"]
